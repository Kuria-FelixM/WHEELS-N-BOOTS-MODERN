# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.railway.app,localhost

# Database (Railway/Heroku will provide DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# CORS Settings
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# PesaFlux SMS API (for SMS sending)
PESAFLUX_API_KEY=your-pesaflux-api-key
PESAFLUX_SENDER_ID=your-sender-id

# Django Superuser (optional, for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=your-admin-password
DJANGO_SUPERUSER_EMAIL=admin@example.com
